# Copy to .env and fill in. .env is git-ignored.

# --- Telegram (required for pushing) ---
# From @BotFather. The bot must be an admin of the channel with "post messages".
TELEGRAM_BOT_TOKEN=
# Public channel username (e.g. @g0v_rep0rter) or numeric id (-100...).
TELEGRAM_CHAT_ID=
# Private test channel/group id. Used when REP0RTER_TELEGRAM_TEST=1.
TELEGRAM_TEST_CHAT_ID=
REP0RTER_TELEGRAM_TEST=1
# Caption language: en (default), zh-TW, ja, ko. Each photo links to all four editions.
# Missing English translations stay pending until translated; no Chinese fallback.
REP0RTER_TELEGRAM_LANGUAGE=en

# --- Google login for project owners (optional; all three values required) ---
# Create a Web application OAuth client in Google Cloud.
# Authorized redirect URI: https://rep0rter.observe.tw/auth/google/callback
REP0RTER_GOOGLE_CLIENT_ID=
REP0RTER_GOOGLE_CLIENT_SECRET=
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
REP0RTER_WEB_SECRET_KEY=

# --- LLM (OpenAI-compatible chat completions; optional, falls back to plain text) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# --- Tuning (all optional) ---
# REP0RTER_DATA_DIR=./data
# REP0RTER_COLLECT_DAYS=2
# REP0RTER_SCORE_THRESHOLD=6
# REP0RTER_MAX_ITEMS_PER_RUN=5
# REP0RTER_MAX_ITEM_AGE_HOURS=48
# REP0RTER_SITE_TITLE=rep0rter
# REP0RTER_SITE_URL=https://rep0rter.observe.tw
# Optional: existing Chrome executable; otherwise Playwright's Chromium is used.
# REP0RTER_CHROME_PATH=/usr/bin/chromium
# Optional: Noto Sans CJK font file for the Pillow fallback.
# REP0RTER_CARD_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Keep new Slack editorial scores in observation mode for two weeks; no auto-promotion.
REP0RTER_EDITORIAL_MODE=shadow
# Explicit public civic-tech sources only. Bot/CI/dependency notifications are excluded.
REP0RTER_GITHUB_REPOS=
REP0RTER_MASTODON_ACCOUNTS=
# Optional read-only token. Unauthenticated GitHub allows 60 requests an hour per
# address, which the hourly cycle spends on a handful of repositories; a token
# raises that to 5,000. It grants no extra visibility: only explicitly public
# repositories are collected either way. A fine-grained token with no scopes,
# or a classic token with public_repo, is enough.
REP0RTER_GITHUB_TOKEN=
# Optional public Notion portal to propose allowlist candidates from, checked
# weekly by the maintenance service. Proposals go to the admin destination only
# and are never collected or configured automatically; a human still reviews and
# edits REP0RTER_GITHUB_REPOS. Discovery is not part of the hourly cycle.
REP0RTER_NOTION_PORTAL=
# Comma-separated public RSS 2.0 feeds, Notion URLs, and the ODF project archive. No Notion token.
# Code for Korea: news = announcements; civic-tech-projects = project archive.
# Civic Tech Network is separate; ODF uses its RSS filtered to projects via Chromium.
REP0RTER_FEEDS=https://codefor.kr/boards/news.xml,https://codefor.kr/boards/civic-tech-projects.xml,https://code4japan-community.notion.site/Home-9dd9cd85f07942c1bd5f6ef73efdb122,https://civictech.kr/boards/news.xml,https://www.odf.or.kr/archive-project,https://medium.com/feed/codeforkorea
# Legacy alias; merged with REP0RTER_FEEDS and deduplicated.
REP0RTER_RSS_FEEDS=
REP0RTER_COLLECT_REQUEST_BUDGET=80
# Ten repositories plus Slack measure 1,200-1,512 requests a day; 1,500 leaves
# no margin and exhausting it stops collection for the rest of the day.
REP0RTER_COLLECT_DAILY_BUDGET=1800
# Optional administrator-only alerts; never falls back to the public news channel.
REP0RTER_ADMIN_BOT_TOKEN=
REP0RTER_ADMIN_CHAT_ID=
REP0RTER_SEND_ADMIN_ALERTS=0
# Local daily/weekly backup is enabled; off-host replication is optional.
REP0RTER_BACKUP_OFFSITE=
