# Copy to .env and fill in. .env is git-ignored.

# --- Telegram (required for pushing) ---
# From @BotFather. The bot must be an admin of the channel with "post messages".
TELEGRAM_BOT_TOKEN=
# Public channel username (e.g. @g0v_rep0rter) or numeric id (-100...).
TELEGRAM_CHAT_ID=
# Private test channel/group id. Used when REP0RTER_TELEGRAM_TEST=1.
TELEGRAM_TEST_CHAT_ID=
REP0RTER_TELEGRAM_TEST=1
# Caption language: zh-TW, ko, ja, en. Each photo links to all four editions.
REP0RTER_TELEGRAM_LANGUAGE=zh-TW

# --- LLM (OpenAI-compatible chat completions; optional, falls back to plain text) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# --- Tuning (all optional) ---
# REP0RTER_DATA_DIR=./data
# REP0RTER_COLLECT_DAYS=2
# REP0RTER_SCORE_THRESHOLD=6
# REP0RTER_MAX_ITEMS_PER_RUN=5
# REP0RTER_MAX_ITEM_AGE_HOURS=48
# REP0RTER_SITE_TITLE=rep0rter
# REP0RTER_SITE_URL=https://rep0rter.observe.tw
# Optional: existing Chrome executable; otherwise Playwright's Chromium is used.
# REP0RTER_CHROME_PATH=/usr/bin/chromium
# Optional: Noto Sans CJK font file for the Pillow fallback.
# REP0RTER_CARD_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
