# Reproduces the header rules in Caddyfile. Asset responses only:
# _headers never applies to responses generated by worker.js.
#
# Rules accumulate rather than override, so a more specific rule has to drop
# the inherited header with `!` before setting its own value.

/*
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/feed.xml
  ! Content-Type
  Content-Type: application/rss+xml; charset=utf-8

/feed.en.xml
  ! Content-Type
  Content-Type: application/rss+xml; charset=utf-8

/feed.zh-TW.xml
  ! Content-Type
  Content-Type: application/rss+xml; charset=utf-8

/feed.ja.xml
  ! Content-Type
  Content-Type: application/rss+xml; charset=utf-8

/feed.ko.xml
  ! Content-Type
  Content-Type: application/rss+xml; charset=utf-8
