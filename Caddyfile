:80 {
	@accounts path /auth/* /submit /write /projects /projects/*
	handle @accounts {
		reverse_proxy accounts:8000
	}
	handle {
		root * /data/site
		file_server
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /feed*.xml Content-Type "application/rss+xml; charset=utf-8"
	}
	encode gzip
}
